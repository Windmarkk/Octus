{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netaudit.local/contracts/scan_request.schema.json",
  "title": "ScanRequest",
  "description": "Frontend -> FastAPI. Tarama başlatma isteği. Scope Guard #1 (RFC 1918) Pydantic tarafında ayrıca uygulanır; buradaki pattern yalnızca biçimi doğrular.",
  "type": "object",
  "required": ["targets", "authorized"],
  "additionalProperties": false,
  "properties": {
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "IPv4 adresi veya CIDR. Örn: 192.168.1.0/24, 10.0.0.5",
        "pattern": "^(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)(?:/(?:3[0-2]|[12]?\\d))?$"
      }
    },
    "ports": {
      "type": "string",
      "default": "top100",
      "description": "'top100', 'top1000', aralık '1-1024' veya liste '22,80,443' (aralık ve liste karışık olabilir).",
      "pattern": "^(?:top100|top1000|\\d{1,5}(?:-\\d{1,5})?(?:,\\d{1,5}(?:-\\d{1,5})?)*)$"
    },
    "max_rate_pps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000,
      "default": 500,
      "description": "Saniyedeki en fazla bağlantı denemesi (hız sınırı)."
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "default": ["discovery", "ports", "tls"],
      "items": {
        "enum": ["discovery", "ports", "banner", "tls", "passive"]
      }
    },
    "authorized": {
      "const": true,
      "description": "Kullanıcı bu ağı denetleme yetkisine sahip olduğunu onaylar. true değilse istek reddedilir."
    }
  }
}
