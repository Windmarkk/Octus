{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netaudit.local/contracts/core_config.schema.json",
  "title": "CoreConfig",
  "description": "Python orkestratör -> Rust çekirdek. `netaudit-core --config <dosya>` ile verilir. Port ifadeleri Python tarafında açılmış tam listedir.",
  "type": "object",
  "required": ["scan_id", "targets", "ports", "max_rate_pps", "modules", "timeout_ms", "concurrency"],
  "additionalProperties": false,
  "properties": {
    "scan_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{8,64}$" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)(?:/(?:3[0-2]|[12]?\\d))?$"
      }
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65535,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
    },
    "max_rate_pps": { "type": "integer", "minimum": 1, "maximum": 5000 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["discovery", "ports", "banner", "tls", "passive"] }
    },
    "timeout_ms": { "type": "integer", "minimum": 50, "maximum": 30000, "default": 1500 },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 128 }
  }
}
