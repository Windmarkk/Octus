{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netaudit.local/contracts/scan_event.schema.json",
  "title": "CoreEvent",
  "description": "Rust çekirdek -> Python. stdout'ta her satır bir NDJSON olayıdır. Rust `CoreEvent` enum'u (serde tag = \"type\") ile birebir eşleşir. Opsiyonel alanlar Rust'ta Option<T> olduğundan null olabilir.",
  "oneOf": [
    { "$ref": "#/$defs/ScanStarted" },
    { "$ref": "#/$defs/HostFound" },
    { "$ref": "#/$defs/PortResult" },
    { "$ref": "#/$defs/TlsInfo" },
    { "$ref": "#/$defs/PassiveAlert" },
    { "$ref": "#/$defs/Progress" },
    { "$ref": "#/$defs/ScanFinished" },
    { "$ref": "#/$defs/Error" }
  ],
  "$defs": {
    "ScanId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{8,64}$" },
    "Ipv4": { "type": "string", "format": "ipv4" },
    "Mac": {
      "type": ["string", "null"],
      "pattern": "^(?:[0-9a-f]{2}:){5}[0-9a-f]{2}$",
      "description": "Küçük harf, iki nokta ayraçlı. Örn: aa:bb:cc:dd:ee:ff"
    },
    "UnixTs": { "type": "integer", "minimum": 0, "description": "Unix zamanı, saniye." },

    "ScanStarted": {
      "type": "object",
      "required": ["type", "scan_id", "targets", "ts"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "scan_started" },
        "scan_id": { "$ref": "#/$defs/ScanId" },
        "targets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "ts": { "$ref": "#/$defs/UnixTs" }
      }
    },

    "HostFound": {
      "type": "object",
      "required": ["type", "scan_id", "ip"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "host_found" },
        "scan_id": { "$ref": "#/$defs/ScanId" },
        "ip": { "$ref": "#/$defs/Ipv4" },
        "mac": { "$ref": "#/$defs/Mac" },
        "rtt_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },

    "PortResult": {
      "type": "object",
      "required": ["type", "scan_id", "ip", "port", "proto", "state"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "port_result" },
        "scan_id": { "$ref": "#/$defs/ScanId" },
        "ip": { "$ref": "#/$defs/Ipv4" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "proto": { "enum": ["tcp", "udp"] },
        "state": { "enum": ["open", "closed", "filtered"] },
        "service": { "type": ["string", "null"], "maxLength": 64 },
        "banner": { "type": ["string", "null"], "maxLength": 1024 }
      }
    },

    "TlsInfo": {
      "type": "object",
      "required": ["type", "scan_id", "ip", "port", "version", "cipher", "not_after", "weak_sig"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tls_info" },
        "scan_id": { "$ref": "#/$defs/ScanId" },
        "ip": { "$ref": "#/$defs/Ipv4" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "version": { "type": "string", "description": "Örn: TLSv1.2, TLSv1.3" },
        "cipher": { "type": "string" },
        "not_after": { "type": "integer", "description": "Sertifika bitiş zamanı, Unix saniye." },
        "weak_sig": { "type": "boolean", "description": "Sertifika zayıf imza algoritması (örn. SHA-1) kullanıyor mu." }
      }
    },

    "PassiveAlert": {
      "type": "object",
      "required": ["type", "scan_id", "kind", "detail", "ts"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "passive_alert" },
        "scan_id": { "$ref": "#/$defs/ScanId" },
        "kind": { "enum": ["rogue_dhcp", "arp_conflict", "gateway_mac_change"] },
        "detail": { "type": "string", "maxLength": 512 },
        "ts": { "$ref": "#/$defs/UnixTs" }
      }
    },

    "Progress": {
      "type": "object",
      "required": ["type", "scan_id", "done", "total"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "progress" },
        "scan_id": { "$ref": "#/$defs/ScanId" },
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },

    "ScanFinished": {
      "type": "object",
      "required": ["type", "scan_id", "ts"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "scan_finished" },
        "scan_id": { "$ref": "#/$defs/ScanId" },
        "ts": { "$ref": "#/$defs/UnixTs" }
      }
    },

    "Error": {
      "type": "object",
      "required": ["type", "scan_id", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "error" },
        "scan_id": { "$ref": "#/$defs/ScanId" },
        "code": {
          "enum": ["out_of_scope", "invalid_config", "permission_denied", "io_error", "timeout", "internal"]
        },
        "message": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
